---
import { Image } from "astro:assets";
import Icon from "../assets/icon.png";

import ThemeToggle from "./ThemeToggle.astro";
---

<header class="site-header">
  <div class="wrapper nav-wrapper">
    <nav class="site-nav">
      <ul>
        <li><a href="/">Accueil</a></li>
        <li><a href="/about">À propos</a></li>
      </ul>
    </nav>

    <div class="logo-title">
      <Image
        src={Icon}
        alt="Logo Astrog@mers"
        class="logo"
        width={40}
        height={40}
        loading="eager"
        decoding="async"
      />
      <span class="site-title">Astrog@mers</span>
    </div>

    <div class="left-nav">
      <ThemeToggle />
      <a href="/contact" class="contact-link">Me contacter</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    background-color: var(--gray-50);
    padding: 1rem 0;
    box-shadow: var(--shadow-sm);
    height: var(--header-height);
  }

  .nav-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .logo-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo {
    height: 40px;
    width: 40px;
    border-radius: 2rem;
  }

  .site-title {
    font-size: var(--text-lg);
    color: var(--accent-regular);
    font-weight: bold;
  }

  .site-nav ul {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    text-decoration: none;
    color: var(--gray-200);
    font-weight: 500;
    transition: color var(--theme-transition);
  }

  .site-nav a:hover {
    color: var(--accent-regular);
  }

  .contact-link {
    text-decoration: none;
    color: var(--accent-regular);
    font-weight: 600;
    border: 1px solid var(--accent-regular);
    padding: 0.5rem 1rem;
    border-radius: 0.25rem;
    transition:
      background-color var(--theme-transition),
      color var(--theme-transition);
  }

  .contact-link:hover {
    background-color: var(--accent-regular);
    color: var(--accent-text-over);
  }

  .wrapper {
    max-width: 83rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .left-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
</style>
