---
// ZodiacFinder.astro

// Import global styles
import "../styles/fonts.css";
import "../styles/global.css";
---

<script type="module" is:inline>
  import { getZodiacSign } from "/src/utils/getZodiacFromDate.ts";

  document.addEventListener("DOMContentLoaded", () => {
    const findZodiacButton = document.getElementById("findZodiac");
    const birthdateInput = document.getElementById("birthdate");

    findZodiacButton.addEventListener("click", () => {
      const date = new Date(birthdateInput.value);
      if (!isNaN(date)) {
        const month = date.getMonth() + 1;
        const day = date.getDate();
        const sign = getZodiacSign(month, day);
        document.getElementById("result").textContent =
          `Ton signe est : ${sign}`;
      }
    });
  });
</script>

<section class="zodiac-container">
  <div class="zodiac-box">
    <p class="label">TON ZODIAC</p>
    <h2>Découvre ton signe astrologique</h2>

    <div class="form">
      <input type="date" id="birthdate" lang="fr" placeholder="jj/mm/aaaa" />
      <button id="findZodiac" class="cta-button">Découvrir</button>
    </div>

    <p id="result" class="result"></p>
  </div>
</section>

<style>
  .zodiac-container {
    padding: 4rem 2rem;
    border-radius: 3rem 3rem 0 0;
    color: #fff;
    font-family: "Oxanium", sans-serif;
    text-align: center;
    background-size: cover;
    background-position: center;
  }

  .zodiac-box {
    max-width: 900px;
    margin: 0 auto;
  }

  .label {
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--accent-regular);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  h1 {
    font-family: "Orbitron", sans-serif;
    font-size: 2.5rem;
    margin-bottom: 2rem;
  }

  .form {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  input[type="date"] {
    appearance: none;
    -webkit-appearance: none;
    background-color: var(--gray-700);
    border: 1px solid var(--gray-600);
    border-radius: 12px;
    padding: 0.75rem 1.25rem;
    color: var(--gray-100);
    font-family: "Oxanium", sans-serif;
    font-size: 1rem;
    position: relative;
    cursor: pointer;
  }

  input[type="date"]::-webkit-calendar-picker-indicator {
    filter: none;
    color: var(--gray-100);
    opacity: 1;
  }

  input[type="date"]:hover {
    border-color: var(--accent-regular);
  }

  .result {
    font-size: 1.1rem;
    color: var(--accent-regular);
    font-weight: 500;
    margin-top: 1rem;
  }
</style>
